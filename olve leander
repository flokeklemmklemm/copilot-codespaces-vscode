<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Olve's Plasa</title>
    <style>
        body {
            font-family: Arial, sans-serif;
            background-color: #2c3e50;
            color: #ecf0f1;
            margin: 0;
            padding: 0;
        }
        header {
            background-color: #34495e;
            padding: 20px;
            text-align: center;
        }
        header h1 {
            margin: 0;
            color: #e74c3c;
        }
        nav ul {
            list-style-type: none;
            padding: 0;
            text-align: center;
        }
        nav ul li {
            display: inline;
            margin: 0 15px;
        }
        nav ul li a {
            color: #ecf0f1;
            text-decoration: none;
        }
        nav ul li a:hover {
            color: #e74c3c;
        }
        main {
            padding: 20px;
            text-align: center;
        }
        iframe {
            width: 80%;
            height: 500px;
            border: none;
        }
        footer {
            background-color: #34495e;
            text-align: center;
            padding: 10px;
            position: fixed;
            bottom: 0;
            width: 100%;
        }
    </style>
</head>
<body>
    <header>
        <h1>Olve's Plasa</h1>
        <nav>
            <ul>
                <li><a href="#home">Home</a></li>
                <li><a href="#games">Play Poki</a></li>
                <li><a href="#contact">Contact</a></li>
            </ul>
        </nav>
    </header>
    <main>
        <section id="home">
            <h2>Welcome to Olve's Plasa</h2>
            <p>Enjoy a variety of games directly on our platform.</p>
        </section>
        <section id="games">
            <h2>Play Poki Games</h2>
            <iframe src="https://poki.com"></iframe>
        </section>
        <section id="contact">
            <h2>Contact Us</h2>
            <p>Have questions or suggestions? Get in touch with us!</p>
        </section>
    </main>
    <footer>
        <p>&copy; 2025 Olve's Plasa. All Rights Reserved.</p>
    </footer>
</body>
</html>
